@model InstagramApp.Models.LoginViewModel
@{ ViewData["Title"] = "Вход"; }

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card p-4 text-center">
            <h1 class="insta-brand mb-4">Instagram</h1>
            <form asp-action="Login" method="post">
                <div asp-validation-summary="All" class="text-danger small mb-2"></div>
                <div class="mb-2">
                    <input asp-for="LoginOrEmail" class="form-control search-input" placeholder="Телефон, имя пользователя или email" />
                </div>
                <div class="mb-3">
                    <input asp-for="Password" class="form-control search-input" placeholder="Пароль" />
                </div>
                <button type="submit" class="btn btn-primary w-100 fw-bold">Войти</button>
            </form>
        </div>
        <div class="card p-3 text-center mt-2">
            <span>У вас ещё нет аккаунта? <a asp-action="Register" class="text-primary text-decoration-none fw-bold">Зарегистрироваться</a></span>
        </div>
    </div>
</div>